# Copy to .env. Never commit real tokens or passwords.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only this numeric Telegram chat ID is allowed to control the bot.
GITHUB_TOKEN=
OLLAMA_HOST=http://127.0.0.1:11434
MODEL_NAME=llama3.2
NCLAW_ENV=development
NCLAW_LOG_LEVEL=INFO
NCLAW_WORKSPACE=workspace
# Local data directory (default is private Termux app storage: ~/.nclaw)
NCLAW_DATA_DIR=~/.nclaw
# Google Drive OAuth Desktop client JSON; keep both files private and out of Git
GOOGLE_DRIVE_CREDENTIALS=~/.nclaw/google-oauth-client.json
GOOGLE_DRIVE_TOKEN=~/.nclaw/google-drive-token.json

# TokenGuard: approximate local context budget (no model switching)
NCLAW_CONTEXT_WINDOW=8192
NCLAW_TOKEN_THRESHOLD=0.90
